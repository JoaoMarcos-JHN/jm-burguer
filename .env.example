# Copy to .env.local and fill in. Never commit .env.local.

# Supabase > Project Settings > API Keys (publishable and secret/service_role)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: lets the server write orders. Only on the server and in Vercel's settings.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Connect > Session pooler. Used only by "pnpm db:push" to apply
# the migrations; the site itself never uses it.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Cloudflare Turnstile (captcha). These are Cloudflare's test keys, which
# always pass; swap them for real ones from dash.cloudflare.com before going live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
